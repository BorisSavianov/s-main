<!-- apps/notification-service/src/templates/email/email-verification.hbs -->

<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Verify Your Email</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        color: #333;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        background: #4f46e5;
        color: white;
        padding: 20px;
        text-align: center;
        border-radius: 10px 10px 0 0;
      }
      .content {
        padding: 30px;
        background: #f9fafb;
        border-radius: 0 0 10px 10px;
      }
      .button {
        display: inline-block;
        padding: 12px 24px;
        background: #4f46e5;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        margin: 20px 0;
      }
      .footer {
        text-align: center;
        padding: 20px;
        color: #666;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        <h1>Verify Your Email Address</h1>
      </div>
      <div class='content'>
        <p>Welcome to {{platformName}}!</p>
        <p>To complete your account setup, please verify your email address by
          clicking the button below:</p>
        <a href='{{verificationUrl}}' class='button'>Verify Email Address</a>
        <p>If you didn't create an account, please ignore this email.</p>
        <p>This link will expire in 24 hours.</p>
      </div>
      <div class='footer'>
        <p>If you have any questions, please contact our support team.</p>
      </div>
    </div>
  </body>
</html>