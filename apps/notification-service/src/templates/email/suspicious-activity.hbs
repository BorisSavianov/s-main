<!-- apps/notification-service/src/templates/email/suspicious-activity.hbs -->

<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Suspicious Activity Alert</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        color: #333;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        background: #dc2626;
        color: white;
        padding: 20px;
        text-align: center;
        border-radius: 10px 10px 0 0;
      }
      .content {
        padding: 30px;
        background: #f9fafb;
        border-radius: 0 0 10px 10px;
      }
      .alert {
        background: #fef2f2;
        border: 1px solid #dc2626;
        padding: 15px;
        border-radius: 5px;
        margin: 20px 0;
      }
      .footer {
        text-align: center;
        padding: 20px;
        color: #666;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>
        <h1>Security Alert</h1>
      </div>
      <div class='content'>
        <p>Hello {{userName}},</p>
        <p>We detected suspicious activity on your account:</p>

        <div class='alert'>
          <p><strong>Activity:</strong> {{activityType}}</p>
          <p><strong>Time:</strong> {{formatDate timestamp}}</p>
        </div>

        <p><strong>Immediate Action Required:</strong></p>
        <p>1. Change your password immediately</p>
        <p>2. Review your recent account activity</p>
        <p>3. Contact our support team if you need assistance</p>

        <p>Your account security is our priority.</p>
        <p><a href='{{securityUrl}}'>Review Security Settings</a></p>
      </div>
      <div class='footer'>
        <p>Contact our support team at
          {{supportEmail}}
          immediately if you have any concerns.</p>
      </div>
    </div>
  </body>
</html>