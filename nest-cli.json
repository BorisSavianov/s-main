{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/serenity-space/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/serenity-space/tsconfig.app.json",
    "assets": [
      {
        "include": "**/*.hbs",
        "outDir": "dist"
      }
    ]
  },
  "monorepo": true,
  "root": "apps/serenity-space",
  "projects": {
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json",
        "assets": [
          {
            "include": "templates/**/*",
            "outDir": "dist"
          }
        ]
      }
    },
    "chat-service": {
      "type": "application",
      "root": "apps/chat-service",
      "entryFile": "main",
      "sourceRoot": "apps/chat-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/chat-service/tsconfig.app.json"
      }
    },
    "mood-service": {
      "type": "application",
      "root": "apps/mood-service",
      "entryFile": "main",
      "sourceRoot": "apps/mood-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/mood-service/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json",
        "assets": [
          {
            "include": "templates/**/*",
            "outDir": "dist"
          }
        ]
      }
    },
    "scheduler-service": {
      "type": "application",
      "root": "apps/scheduler-service",
      "entryFile": "main",
      "sourceRoot": "apps/scheduler-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/scheduler-service/tsconfig.app.json"
      }
    },
    "serenity-space": {
      "type": "application",
      "root": "apps/serenity-space",
      "entryFile": "main",
      "sourceRoot": "apps/serenity-space/src",
      "compilerOptions": {
        "tsConfigPath": "apps/serenity-space/tsconfig.app.json"
      }
    },
    "user-service": {
      "type": "application",
      "root": "apps/user-service",
      "entryFile": "main",
      "sourceRoot": "apps/user-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-service/tsconfig.app.json"
      }
    }
  }
}